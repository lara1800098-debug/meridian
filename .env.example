# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://meridian:meridian@localhost:5432/meridian
# 32+ random chars, used to sign session cookies and encrypt MFA secrets
APP_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Leave empty to run in demo/rules-only mode (no AI calls)
ANTHROPIC_API_KEY=
# Public base URL of the app (used in exported PDFs)
APP_URL=http://localhost:3000
# Contact string sent in the crawler User-Agent (generic by default)
CRAWLER_CONTACT=meridian-crawler
# Set to 1 to mark the instance as demo (banner on every page)
DEMO_MODE=1
UPLOAD_DIR=./uploads
